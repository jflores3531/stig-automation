.venv/
__pycache__/
*.pyc

backups/
audit_logs/
ansible/reports/

# Device output collected for `l2_stig_audit.py --from-capture`. A capture is a
# verbatim copy of a switch's running-config - real addressing, hostnames and
# password hashes - and captures taken at work are someone else's production
# network. This repository is public. Never commit one.
captures/

# Redacted copies of captures, wherever they are written. Redaction removes
# what it has rules for; a capture can carry anything, and a file that is safe
# enough to hand to one person is not thereby safe to publish.
*.redacted.capture
*.redacted.txt

# Filled-in STIG Viewer checklists (`--to-cklb`) and the CSVs the addressing
# tools write. The blank checklists in checklists/ are tracked; a completed one
# names a device and its findings.
checklists/out/
*.cklb.filled

# What a bulk walk leaves beside its checklists: one run log per run, and the
# index of which session produced which checklist. Both name real devices.
run_log_*.csv
collected.csv

# The CSVs arp_inventory.py and pdf_ips.py write. Both are lists of real
# addressing off a real network, which is the thing this repo most carefully
# does not commit. Nothing tracked here is a .csv.
*.csv

# Plaintext secrets used by the *_stig_harden.py scripts (VTP password, NTP auth
# key, etc.) - never commit this. See secrets.yaml.example for the format.
secrets.yaml

# Real inventory holds site-specific device addressing and VLAN IDs.
# Tracked only as a template - see inventory.yaml.example for the format.
inventory.yaml


.idea/
.claude/
.agents/
skills-lock.json

# Ansible vault files holding the same secrets as secrets.yaml above. Tracked
# only as .example templates - the real ones are local, never committed. See
# each vault.yml.example for the expected keys.
ansible/inventory/group_vars/*/vault.yml
